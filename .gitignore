# ---------------------------------------------------------------------------
# YOUR DATA - never commit this.
# outreach.db holds your lead list (real email addresses, store names, notes)
# and the messages you generated. Publishing that to GitHub would expose other
# people's contact details.
# ---------------------------------------------------------------------------
outreach.db
outreach.db-shm
outreach.db-wal
*.db
*.sqlite3

# Your uploaded/exported lead lists
leads*.csv
leads*.xlsx
leads*.txt
personalized-messages.*
clients*.csv

# CLI mode output - the outbox and its spreadsheet contain real email
# addresses, and outbox.json holds both the leads and the written messages.
outbox.html
outbox.json
outbox*.json
messages.csv
*.state.json

# ---------------------------------------------------------------------------
# SECRETS
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json

# Streamlit's own secrets file. Streamlit Community Cloud keeps secrets in its
# web UI, but if you run locally with `streamlit run` it may create this next to
# your code - and it holds your password in plain text.
.streamlit/secrets.toml

