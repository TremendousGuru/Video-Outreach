# Copy this file to ".env" and fill in what you need.
# ".env" is gitignored, so your key stays out of the repo and out of outreach.db.
#
# All of these are optional - you can also paste an API key into the app's
# Settings panel instead, which stores it in your local outreach.db.

# AI writing. Any OpenAI-compatible endpoint works.
OPENAI_API_KEY=

# Point at OpenRouter / Groq / Together / a Gemini compatibility endpoint instead:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini

# Where the app listens. Defaults: 0.0.0.0:8848
HOST=127.0.0.1
PORT=8848
